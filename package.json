{
  "name": "@dsh-external/dsh-model-autopilot",
  "version": "0.3.2",
  "description": "DSH 层自动选模型：免费优先 + 探针 + 故障切换（当前阶段：模型池 + 探针）",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./pool": "./lib/pool/pool.js",
    "./probe": "./lib/probe/probe.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm",
    "model-router",
    "free-model"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "node --test \"test/*.test.mjs\" && node scripts/verify-build-sync.mjs",
    "smoke": "node scripts/smoke.mjs",
    "repair": "node scripts/repair-state.mjs",
    "verify:sync": "node scripts/verify-build-sync.mjs",
    "verify:exhaustion": "node scripts/verify-exhaustion-modes.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
